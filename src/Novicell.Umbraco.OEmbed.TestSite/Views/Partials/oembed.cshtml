@using Novicell.Umbraco.OEmbed.Models
@model OEmbedValue
@{
    // Url is what the editor entered. OEmbed is what the provider returned, with typed properties (Type, Title,
    // Html, Url, ThumbnailUrl, ...).
    OEmbedResponse oembed = Model.OEmbed;
    OEmbedScripts scripts = ViewContext.HttpContext.Request.Query.TryGetValue("raw", out var raw) && raw == "1" ?
        OEmbedScripts.Raw :
        OEmbedScripts.Block;

    OEmbedRenderOptions renderOptions = new OEmbedRenderOptions { Scripts = scripts };
}
<figure data-type="@oembed.Type.ToString().ToLowerInvariant()">
    @if (oembed.Type == OEmbedType.Photo && oembed.Url is not null)
    {
        <img src="@oembed.Url" alt="@oembed.Title">
    }
    else
    {
        @* The provider's html exactly as it is when it is one safe iframe (YouTube, Vimeo, Spotify, SoundCloud),
           and nothing for markup with a script of its own (X, TikTok, Reddit): the saved html is posted by the
           backoffice and is not verified. @Html.OEmbed(Model, new OEmbedRenderOptions { Scripts = OEmbedScripts.Raw })
           writes any html as it is, on a site that trusts its editors with that. *@
        @Html.OEmbed(Model, options: renderOptions)
    }

    <figcaption>
        @* The site decides what else to show; the link is also what a visitor gets when the html was left out. *@
        <a href="@Model.Url">@(oembed.Title ?? Model.Url.ToString())</a>
        from @Model.OEmbed.ProviderName

        @* A field the provider returned that has no property is read by its name, here one only Vimeo returns *@
        @if (oembed.TryGetValue("video_id", out long videoId))
        {
            <span>(Vimeo video @videoId)</span>
        }
    </figcaption>
</figure>
